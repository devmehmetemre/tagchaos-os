#!/bin/sh
# TAGCHAOS OS - Advanced Universal TUI Installer
set -e

if [ "$(id -u)" -ne 0 ]; then
    echo "[!] Bu aracı çalıştırmak için root yetkisi gereklidir."
    exit 1
fi

export DIALOGRC=""

# 1. Dil Seçimi
LANG_CHOICE=$(dialog --clear --title "TAGCHAOS OS - Language / Dil" \
    --menu "Lütfen bir dil seçin / Select language:" 15 60 5 \
    "tr_TR.UTF-8" "Türkçe (Turkish)" \
    "en_US.UTF-8" "English (US)" \
    "de_DE.UTF-8" "Deutsch (German)" \
    "fr_FR.UTF-8" "Français (French)" \
    "es_ES.UTF-8" "Español (Spanish)" \
    3>&1 1>&2 2>&3) || exit 1

# 2. Zaman Dilimi Seçimi
TIMEZONE=$(dialog --clear --title "TAGCHAOS OS - Timezone" \
    --menu "Zaman diliminizi seçin:" 16 60 7 \
    "Europe/Istanbul" "Istanbul (GMT+3)" \
    "Europe/London" "London (GMT+0)" \
    "Europe/Berlin" "Berlin (GMT+1)" \
    "America/New_York" "New York (GMT-5)" \
    "Asia/Tokyo" "Tokyo (GMT+9)" \
    "UTC" "Universal Coordinated Time" \
    3>&1 1>&2 2>&3) || exit 1

# 3. Masaüstü Ortamı Seçimi
DE_CHOICE=$(dialog --clear --title "TAGCHAOS OS - Masaüstü Ortamı Seçimi" \
    --menu "Kurmak istediğiniz masaüstü ortamını seçin:" 16 65 4 \
    "XFCE4" "XFCE4 (Hızlı, Hafif, Stabil - Önerilen)" \
    "PLASMA" "KDE Plasma (Modern, Görsel Şölen)" \
    "GNOME" "GNOME Desktop (Sade ve Modern)" \
    "CLI" "Minimalist Terminal (Masaüstü Yok)" \
    3>&1 1>&2 2>&3) || exit 1

# 4. Disk Seçimi
DISKS=$(lsblk -dn -o NAME,SIZE,TYPE | grep "disk" | awk '{print "/dev/"$1" "$2}')
if [ -z "$DISKS" ]; then
    dialog --title "HATA" --msgbox "Kurulum yapılabilecek bir sabit disk bulunamadı!" 8 50
    exit 1
fi

TARGET_DISK=$(dialog --clear --title "TAGCHAOS OS - Disk Seçimi" \
    --menu "Kurulum yapılacak hedef diski seçin:" 15 60 5 \
    $DISKS \
    3>&1 1>&2 2>&3) || exit 1

# 5. Kullanıcı Bilgileri
USERNAME=$(dialog --clear --title "Kullanıcı Oluşturma" \
    --inputbox "Oluşturulacak kullanıcı adı:" 8 45 "tagchaos" \
    3>&1 1>&2 2>&3) || exit 1

USER_PASS=$(dialog --clear --title "Kullanıcı Parolası" \
    --inputbox "Kullanıcı parolası:" 8 45 "1234" \
    3>&1 1>&2 2>&3) || exit 1

ROOT_PASS=$(dialog --clear --title "Root Parolası" \
    --inputbox "Sistem Root yöneticisi parolası:" 8 45 "root" \
    3>&1 1>&2 2>&3) || exit 1

# 6. Onay
dialog --clear --title "UYARI - Disk Biçimlendirilecek" \
    --yesno "$TARGET_DISK diski tamamen SILINECEK!\n\nSeçilen Masaüstü: $DE_CHOICE\nZaman Dilimi: $TIMEZONE\n\nDevam etmek istiyor musunuz?" 12 60 || exit 0

# 7. Kurulum İşlemi
(
    echo "10"; echo "XXX\nDisk MBR olarak bölümlendiriliyor... \nXXX"
    dd if=/dev/zero of="$TARGET_DISK" bs=1M count=10 status=none
    parted -s "$TARGET_DISK" mklabel msdos
    parted -s "$TARGET_DISK" mkpart primary ext4 1MiB 100%
    parted -s "$TARGET_DISK" set 1 boot on
    sleep 2

    PART="${TARGET_DISK}1"
    case "$TARGET_DISK" in
        *nvme*|*mmcblk*) PART="${TARGET_DISK}p1" ;;
    esac

    echo "25"; echo "XXX\nDosya sistemi oluşturuluyor (ext4)... \nXXX"
    mkfs.ext4 -F -L "TAGCHAOS_OS" "$PART" >/dev/null 2>&1

    MOUNT_DIR="/mnt/tagchaos-target"
    mkdir -p "$MOUNT_DIR"
    mount "$PART" "$MOUNT_DIR"

    echo "45"; echo "XXX\nAna sistem dosyaları diske kopyalanıyor... \nXXX"
    if [ -f /mnt/cdrom/system.tar.xz ]; then
        tar -xf /mnt/cdrom/system.tar.xz -C "$MOUNT_DIR/"
    elif [ -f /system.tar.xz ]; then
        tar -xf /system.tar.xz -C "$MOUNT_DIR/"
    fi

    echo "60"; echo "XXX\nfstab ve Sanal Sürücüler Yapılandırılıyor... \nXXX"
    UUID=$(blkid -s UUID -o value "$PART")
    mkdir -p "$MOUNT_DIR/etc"
    echo "UUID=$UUID  /  ext4  rw,relatime,errors=remount-ro  0  1" > "$MOUNT_DIR/etc/fstab"

    mkdir -p "$MOUNT_DIR/proc" "$MOUNT_DIR/sys" "$MOUNT_DIR/dev"
    mount --bind /dev "$MOUNT_DIR/dev"
    mount --bind /proc "$MOUNT_DIR/proc"
    mount --bind /sys "$MOUNT_DIR/sys"

    echo "70"; echo "XXX\nSeçilen Masaüstü Ortamı ($DE_CHOICE) Kuruluyor... \nXXX"
    case "$DE_CHOICE" in
        "XFCE4")
            chroot "$MOUNT_DIR" apk add --no-cache xorg-server xf86-input-libinput xf86-video-modesetting xf86-video-vesa xfce4 xfce4-terminal lightdm lightdm-gtk-greeter dbus
            chroot "$MOUNT_DIR" rc-update add lightdm default 2>/dev/null || true
            ;;
        "PLASMA")
            chroot "$MOUNT_DIR" apk add --no-cache xorg-server plasma desktop-testing sddm dbus
            chroot "$MOUNT_DIR" rc-update add sddm default 2>/dev/null || true
            ;;
        "GNOME")
            chroot "$MOUNT_DIR" apk add --no-cache xorg-server gnome gdm dbus
            chroot "$MOUNT_DIR" rc-update add gdm default 2>/dev/null || true
            ;;
        "CLI")
            echo "Minimalist Terminal Seçildi."
            ;;
    esac

    echo "85"; echo "XXX\nYerel Ayarlar ve Boot Modülleri Yapılandırılıyor... \nXXX"
    chroot "$MOUNT_DIR" ln -sf "/usr/share/zoneinfo/$TIMEZONE" /etc/localtime 2>/dev/null || true
    echo "LANG=$LANG_CHOICE" > "$MOUNT_DIR/etc/profile.d/locale.sh"
    echo "tagchaos-os" > "$MOUNT_DIR/etc/hostname"

    # Kullanıcı Ayarları
    echo "root:$ROOT_PASS" | chroot "$MOUNT_DIR" chpasswd
    chroot "$MOUNT_DIR" adduser -D -s /bin/bash "$USERNAME" 2>/dev/null || true
    echo "$USERNAME:$USER_PASS" | chroot "$MOUNT_DIR" chpasswd
    chroot "$MOUNT_DIR" addgroup "$USERNAME" wheel 2>/dev/null || true

    # Kök disk ve dosya sistemi modüllerini mkinitfs'e zorla ekliyoruz
    mkdir -p "$MOUNT_DIR/etc/mkinitfs"
    echo 'features="base ata ide scsi ext4 nvme virtio kms"' > "$MOUNT_DIR/etc/mkinitfs/mkinitfs.conf"

    KERNEL_VER=$(ls "$MOUNT_DIR/lib/modules" | tail -n 1)
    chroot "$MOUNT_DIR" mkinitfs -k "$KERNEL_VER" -o "/boot/initramfs-lts"

    echo "95"; echo "XXX\nGRUB MBR Diske Enjekte Ediliyor... \nXXX"
    # GRUB önyükleyici modüllerini diske yaz
    chroot "$MOUNT_DIR" grub-install --target=i386-pc --boot-directory=/boot --recheck --force "$TARGET_DISK"

    # Kesin çalışan GRUB yapılandırması
    chroot "$MOUNT_DIR" sh -c "cat << 'EOF' > /boot/grub/grub.cfg
set timeout=3
set default=0

insmod part_msdos
insmod ext2
insmod all_video

menuentry \"TAGCHAOS OS\" {
    search --no-floppy --fs-uuid --set=root $UUID
    linux /boot/vmlinuz-lts root=UUID=$UUID rw console=tty1 quiet
    initrd /boot/initramfs-lts
}
EOF"

    umount -R "$MOUNT_DIR/dev" "$MOUNT_DIR/proc" "$MOUNT_DIR/sys" 2>/dev/null || true
    umount "$MOUNT_DIR" 2>/dev/null || true

    echo "100"; echo "XXX\nKurulum Başarıyla Tamamlandı! \nXXX"
    sleep 1
) | dialog --title "TAGCHAOS OS Kuruluyor" --gauge "Lütfen bekleyin, sistem kuruluyor..." 10 65 0

dialog --clear --title "BAŞARILI" --msgbox "TAGCHAOS OS diske başarıyla kuruldu!\n\nSanal makineden ISO'yu (CD/DVD) çıkarın ve 'reboot' yazarak yeniden başlatın." 10 60
clear
