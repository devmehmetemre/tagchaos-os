#!/bin/sh
set -e
TARGET_DISK=$1
[ -z "$TARGET_DISK" ] && { echo "[!] Kullanım: tgh-install /dev/hedef_disk"; exit 1; }

echo "[*] UYARI: $TARGET_DISK silinecek! Devam için 'YES' yazın:"
read CONFIRM
[ "$CONFIRM" != "YES" ] && { echo "İptal."; exit 0; }

# fdisk üzerinden MBR primary bootable partition oluşturma
printf "o\nn\np\n1\n\n\na\n1\nw\n" | fdisk "$TARGET_DISK" || true

PART="${TARGET_DISK}1"
[ -b "${TARGET_DISK}p1" ] && PART="${TARGET_DISK}p1"

mkfs.ext4 -F "$PART"

MOUNT_DIR="/mnt/tagchaos-target"
mkdir -p "$MOUNT_DIR"
mount "$PART" "$MOUNT_DIR"
cp -a / * "$MOUNT_DIR" 2>/dev/null || true
rm -rf "$MOUNT_DIR/mnt/*" "$MOUNT_DIR/proc/*" "$MOUNT_DIR/sys/*" "$MOUNT_DIR/dev/*"
mkdir -p "$MOUNT_DIR/proc" "$MOUNT_DIR/sys" "$MOUNT_DIR/dev" "$MOUNT_DIR/mnt"
umount "$MOUNT_DIR"
echo "[+] Kurulum tamamlandı!"
