#!/bin/sh
set -e

TARGET_DISK=""
for d in /dev/sd* /dev/vd* /dev/nvme0n1; do
    [ -b "$d" ] && { TARGET_DISK="$d"; break; }
done

[ -z "$TARGET_DISK" ] && { echo "[!] Hiçbir hedef disk bulunamadı!"; exit 1; }

echo "[*] Bulunan hedef disk: $TARGET_DISK"
echo "[*] UYARI: $TARGET_DISK silinecek! Devam için 'YES' yazın:"
read CONFIRM
[ "$CONFIRM" != "YES" ] && { echo "İptal."; exit 0; }

printf "o\nn\np\n1\n\n\na\n1\nw\n" | fdisk "$TARGET_DISK" || true

PART="${TARGET_DISK}1"
case "$TARGET_DISK" in
    *nvme*) PART="${TARGET_DISK}p1" ;;
esac

mkfs.ext4 -F "$PART"

MOUNT_DIR="/mnt/tagchaos-target"
mkdir -p "$MOUNT_DIR"
mount "$PART" "$MOUNT_DIR"

# Payload arşivini aç (Tertemiz sistem kopyası)
PAYLOAD=""
[ -f /rootfs.tar.gz ] && PAYLOAD="/rootfs.tar.gz"

if [ -n "$PAYLOAD" ]; then
    echo "[*] Temiz sistem payload'ı diske açılıyor..."
    tar -xzf "$PAYLOAD" -C "$MOUNT_DIR/"
else
    echo "[!] Payload bulunamadı, fallback kopya deneniyor..."
    cp -a /bin /etc /lib /root /sbin /usr /var "$MOUNT_DIR/" 2>/dev/null || true
fi

mkdir -p "$MOUNT_DIR/proc" "$MOUNT_DIR/sys" "$MOUNT_DIR/dev" "$MOUNT_DIR/mnt" "$MOUNT_DIR/tmp" "$MOUNT_DIR/run"

# Kernel ve initramfs hedef diskin boot dizinine kopyala
mkdir -p "$MOUNT_DIR/boot"
cp -v /boot/vmlinuz-lts "$MOUNT_DIR/boot/" 2>/dev/null || true
cp -v /boot/initramfs-lts "$MOUNT_DIR/boot/" 2>/dev/null || true

# Hedef sisteme GRUB BIOS kurulumu
mount --bind /dev "$MOUNT_DIR/dev"
mount --bind /proc "$MOUNT_DIR/proc"
mount --bind /sys "$MOUNT_DIR/sys"

chroot "$MOUNT_DIR" grub-install --target=i386-pc --recheck "$TARGET_DISK" || true
chroot "$MOUNT_DIR" sh -c "echo 'set timeout=3' > /boot/grub/grub.cfg && echo 'menuentry \"TAGCHAOS OS\" { linux /boot/vmlinuz-lts root=$PART ro; initrd /boot/initramfs-lts; }' >> /boot/grub/grub.cfg" || true

umount -R "$MOUNT_DIR/dev" "$MOUNT_DIR/proc" "$MOUNT_DIR/sys" 2>/dev/null || true
umount "$MOUNT_DIR"
echo "[+] Kurulum tamamlandı! Makineyi yeniden başlatıp diskten boot edebilirsin."
