#!/bin/sh
set -e

echo "=========================================="
echo "      TAGCHAOS OS DISK KURUCU            "
echo "=========================================="

# Canlı sistemin bağlı olduğu ISO diskini tespit et
LIVE_DEV=""
if mountpoint -q /mnt/cdrom; then
    LIVE_DEV=$(mount | grep /mnt/cdrom | awk '{print $1}' | sed 's/[0-9]*$//' | sed 's/p[0-9]*$//')
fi

TARGET_DISK=""
for d in /dev/sda /dev/sdb /dev/vda /dev/vdb /dev/nvme0n1 /dev/mmcblk0 /dev/mmcblk1; do
    if [ -b "$d" ]; then
        case "$d" in
            /dev/sr*) continue ;;
        esac
        # Canlı ISO medyasını hedef disk olarak seçme
        if [ -n "$LIVE_DEV" ] && echo "$d" | grep -q "$LIVE_DEV"; then
            continue
        fi
        # Salt okunur (CD-ROM) sürücüleri atla
        IS_RO=$(cat /sys/block/$(basename $d)/ro 2>/dev/null || echo "0")
        if [ "$IS_RO" = "1" ]; then
            continue
        fi

        TARGET_DISK="$d"
        break
    fi
done

if [ -z "$TARGET_DISK" ]; then
    echo "[!] HATA: Yüklenecek uygun boş/yazılabilir disk bulunamadı!"
    echo "VirtualBox ayarlarından sanal bir sabit disk (VDI) eklendiğinden emin olun."
    exit 1
fi

echo "[*] Hedef Disk Saptandı: $TARGET_DISK"
echo "[!] UYARI: $TARGET_DISK üzerindeki TÜM VERİLER SİLİNECEKTİR!"
echo "Devam etmek için 'YES' yazın:"
read CONFIRM
if [ "$CONFIRM" != "YES" ]; me
    echo "Kurulum iptal edildi."
    exit 0
fi

echo "[*] Disk bölümlendiriliyor (MBR/Legacy)..."
printf "o\nn\np\n1\n\n\na\n1\nw\n" | fdisk "$TARGET_DISK" || true

PART="${TARGET_DISK}1"
case "$TARGET_DISK" in
    *nvme*|*mmcblk*) PART="${TARGET_DISK}p1" ;;
esac

echo "[*] Dosya sistemi oluşturuluyor (ext4): $PART"
mkfs.ext4 -F "$PART"

MOUNT_DIR="/mnt/tagchaos-target"
mkdir -p "$MOUNT_DIR"
mount "$PART" "$MOUNT_DIR"

PAYLOAD="/mnt/cdrom/system.tar.xz"
if [ ! -f "$PAYLOAD" ]; then
    echo "[!] HATA: Sistem imajı ($PAYLOAD) bulunamadı!"
    umount "$MOUNT_DIR"
    exit 1
fi

echo "[*] Sistem diske aktarılıyor..."
tar -xf "$PAYLOAD" -C "$MOUNT_DIR/"

mkdir -p "$MOUNT_DIR/proc" "$MOUNT_DIR/sys" "$MOUNT_DIR/dev" "$MOUNT_DIR/mnt" "$MOUNT_DIR/tmp" "$MOUNT_DIR/run"

echo "[*] Ön yükleyici ve çekirdek yapılandırılıyor..."
mount --bind /dev "$MOUNT_DIR/dev"
mount --bind /proc "$MOUNT_DIR/proc"
mount --bind /sys "$MOUNT_DIR/sys"

chroot "$MOUNT_DIR" apk add --no-cache mkinitfs
LTS_VER=$(ls "$MOUNT_DIR/lib/modules" | tail -n 1)
chroot "$MOUNT_DIR" mkinitfs -o /boot/initramfs-lts "$LTS_VER" || true

chroot "$MOUNT_DIR" grub-install --target=i386-pc --recheck "$TARGET_DISK" || true

chroot "$MOUNT_DIR" sh -c "cat << 'EOF' > /boot/grub/grub.cfg
set timeout=3
set default=0
menuentry \"TAGCHAOS OS\" {
    linux /boot/vmlinuz-lts root=$PART ro quiet
    initrd /boot/initramfs-lts
}
EOF"

chroot "$MOUNT_DIR" rc-update add iwd default 2>/dev/null || true

umount -R "$MOUNT_DIR/dev" "$MOUNT_DIR/proc" "$MOUNT_DIR/sys" 2>/dev/null || true
umount "$MOUNT_DIR"

echo "=========================================="
echo " [+] TAGCHAOS OS Kurulumu Başarıyla Tamamlandı!"
echo "     Medyayı çıkarıp sistemi yeniden başlatabilirsiniz."
echo "=========================================="
